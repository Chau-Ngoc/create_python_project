[build-system]
requires = ["setuptools >= 61.0"]
build-backend = "setuptools.build_meta"

[project]
name = "{{project_name}}"
version = "{{project_version}}"
authors = [
    {name = "{{author_name}}", email = "{{author_email}}"},
]
description = "Use this project to create a starter template for your next Python project."
readme = "README.md"

[tool.ruff]
line-length = 119

[tool.isort]
line_length = 119
